# Test Azure Functions API Endpoints
# All responses follow the standard format:
# {
#   "success": boolean,
#   "message": string,
#   "data": any,
#   "errors": string[] (optional),
#   "timestamp": string,
#   "statusCode": number
# }
# 
# ⚠️ IMPORTANTE: Los endpoints de USER CREATION requieren autenticación JWT
# Para pruebas con autenticación, usar el archivo: api-tests-with-auth.http
#
# 🛒 NUEVO SISTEMA DE PAGOS (funcCreatePayment):
# - Sistema modernizado basado en productos y carrito de compras
# - Soporte para múltiples productos con cantidades y colores
# - Integración exclusiva con Wompi (sin MercadoPago)
# - Normalización con tabla OrderDetail para histórico de precios
# - Respuesta incluye: purchaseId, paymentUrl (Wompi), totalAmount, items

###
# PUBLIC ENDPOINTS (No authentication required)
###

### Health Check - Database Connection Test
GET http://localhost:7071/api/funcHealthDB

### Login with Admin User - Success Response
POST http://localhost:7071/api/funcLogin
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin123"
}

### Login with Regular User - Success Response
POST http://localhost:7071/api/funcLogin
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "user123"
}

### Login with Invalid Credentials - Error Response
POST http://localhost:7071/api/funcLogin
Content-Type: application/json

{
  "email": "invalid@example.com",
  "password": "invalid"
}

### Login with Missing Password - Validation Error Response
POST http://localhost:7071/api/funcLogin
Content-Type: application/json

{
  "email": "admin@example.com"
}

### Login with Empty Body - Validation Error Response
POST http://localhost:7071/api/funcLogin
Content-Type: application/json

{}

### Create Payment - Modern Product-Based System (Wompi)
### Creates a purchase with multiple products and generates Wompi payment URL
POST http://localhost:7071/api/v1/payment/create
Content-Type: application/json

{
  "buyerEmail": "cliente@ejemplo.com",
  "buyerName": "Juan Pérez",
  "buyerIdentificationNumber": "12345678",
  "buyerContactNumber": "+573001234567",
  "shippingAddress": "Calle 123 #45-67, Bogotá",
  "items": [
    {
      "productId": 1,
      "quantity": 2,
      "selectedColor": "Azul"
    },
    {
      "productId": 3,
      "quantity": 1,
      "selectedColor": "Rojo"
    }
  ]
}

### Create Payment - Minimal Required Fields
POST http://localhost:7071/api/v1/payment/create
Content-Type: application/json

{
  "buyerEmail": "test@ejemplo.com",
  "buyerName": "Test User",
  "buyerIdentificationNumber": "987654321",
  "buyerContactNumber": "3001234567",
  "items": [
    {
      "productId": 1,
      "quantity": 1
    }
  ]
}

### Create Payment - Invalid Email (Should fail with validation error)
POST http://localhost:7071/api/v1/payment/create
Content-Type: application/json

{
  "buyerEmail": "email-invalido",
  "buyerName": "Test User",
  "buyerIdentificationNumber": "987654321",
  "buyerContactNumber": "3001234567",
  "items": [
    {
      "productId": 1,
      "quantity": 1
    }
  ]
}

### Create Payment - Missing Required Fields (Should fail)
POST http://localhost:7071/api/v1/payment/create
Content-Type: application/json

{
  "buyerEmail": "test@ejemplo.com",
  "items": []
}

### Create Payment - Invalid Product ID (Should fail)
POST http://localhost:7071/api/v1/payment/create
Content-Type: application/json

{
  "buyerEmail": "test@ejemplo.com",
  "buyerName": "Test User",
  "buyerIdentificationNumber": "987654321",
  "buyerContactNumber": "3001234567",
  "items": [
    {
      "productId": 999999,
      "quantity": 1
    }
  ]
}

### Clients - List all clients
GET http://localhost:7071/api/v1/clients
Authorization: Bearer <JWT_TOKEN>

### Clients - Filter by name
GET http://localhost:7071/api/v1/clients?name=juan
Authorization: Bearer <JWT_TOKEN>

### Clients - Get client by ID
GET http://localhost:7071/api/v1/clients/1
Authorization: Bearer <JWT_TOKEN>

### Clients - Create client
POST http://localhost:7071/api/v1/clients
Content-Type: application/json
Authorization: Bearer <JWT_TOKEN>

{
  "name": "Juan Pérez",
  "phone": "+573001112233",
  "email": "juan.perez@ejemplo.com",
  "notes": "Cliente frecuente"
}

### Clients - Update client
PUT http://localhost:7071/api/v1/clients/1
Content-Type: application/json
Authorization: Bearer <JWT_TOKEN>

{
  "phone": "+573009998877",
  "isActive": true
}

### Clients - Delete client
DELETE http://localhost:7071/api/v1/clients/1
Authorization: Bearer <JWT_TOKEN>

